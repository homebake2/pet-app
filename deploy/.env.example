# Образец .env для ручного запуска. При деплое через GitHub Actions файл
# создаётся автоматически из GitHub Secrets и Variables с теми же именами
# (см. шаг "Render .env" в .github/workflows/deploy.yml).
#
# Variables: DOMAIN, POSTGRES_USER, POSTGRES_DB, S3_ENDPOINT, S3_REGION,
#            S3_BUCKET, SENTRY_ENVIRONMENT
# Secrets:   POSTGRES_PASSWORD, JWT_SECRET, S3_KEY_ID, S3_APPLICATION_KEY,
#            ADMIN_KEY, WEB_API_KEY, SENTRY_DSN

# Домен, A-запись которого указывает на публичный IP ВМ
DOMAIN=api.pethealth-app.ru

POSTGRES_USER=pet
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pets

# openssl rand -hex 32
JWT_SECRET=change-me

# Yandex Object Storage (ключи статического доступа сервисного аккаунта)
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_KEY_ID=
S3_APPLICATION_KEY=

# Необязательные (пустое значение = выключено)
ADMIN_KEY=
WEB_API_KEY=
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
